{
  "name": "lohas-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run assets:optimize",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none tests/game.test.mjs tests/assets.test.mjs tests/service-van.test.mjs tests/passengers.test.mjs tests/wheelchair.test.mjs tests/driver.test.mjs tests/orbit.test.mjs tests/caregiver.test.mjs tests/city-planning.test.mjs tests/exploration.test.mjs tests/street-furniture.test.mjs tests/rendering.test.mjs tests/campuses.test.mjs tests/progress.test.mjs tests/quality.test.mjs tests/optimized-assets.test.mjs tests/pedestrian-street.test.mjs tests/nearby-labels.test.mjs",
    "test:quality:browser": "node tests/quality.browser.mjs",
    "test:minimap": "node tests/minimap.browser.mjs",
    "test:mobile-interface": "node tests/mobile-interface.browser.mjs",
    "test:rendering": "node --test tests/rendering.test.mjs",
    "assets:optimize": "node tools/optimize-assets.mjs",
    "test:quality": "node --test --test-isolation=none tests/quality.test.mjs tests/optimized-assets.test.mjs",
    "test:progress": "node --test --test-isolation=none tests/progress.test.mjs",
    "test:pwa": "node tests/pwa.browser.mjs",
    "test:rendering:browser": "node tests/rendering.browser.mjs",
    "test:campuses:browser": "node tests/campuses.browser.mjs",
    "benchmark:rendering": "node tools/measure-rendering.mjs",
    "test:orbit": "node tests/orbit.browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:ui": "node tests/onboarding.browser.mjs",
    "test:input": "node tests/input.browser.mjs",
    "test:exploration": "node --test --test-isolation=none tests/exploration.test.mjs",
    "test:exploration:browser": "node tests/exploration.browser.mjs",
    "test:all": "npm run test && node tests/run-browser-all.mjs",
    "test:retry": "node tests/run-browser-all.mjs --retry-failed",
    "test:vehicle": "node tests/vehicle.browser.mjs",
    "test:signals": "node tests/turn-signals.browser.mjs",
    "test:street": "node --test --test-isolation=none tests/pedestrian-street.test.mjs tests/nearby-labels.test.mjs",
    "test:street:browser": "node tests/pedestrian-street.browser.mjs",
    "test:passengers": "node tests/passengers.browser.mjs",
    "test:wheelchair": "node tests/wheelchair.browser.mjs",
    "test:routes": "node tests/routes.browser.mjs",
    "test:expansion": "node tests/expansion.browser.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.175.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "draco3dgltf": "^1.5.9",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
