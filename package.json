{
  "name": "lohas-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none tests/game.test.mjs tests/assets.test.mjs tests/service-van.test.mjs tests/passengers.test.mjs tests/wheelchair.test.mjs tests/driver.test.mjs tests/orbit.test.mjs tests/caregiver.test.mjs tests/city-planning.test.mjs tests/exploration.test.mjs tests/street-furniture.test.mjs",
    "test:orbit": "node tests/orbit.browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:ui": "node tests/onboarding.browser.mjs",
    "test:input": "node tests/input.browser.mjs",
    "test:exploration": "node --test --test-isolation=none tests/exploration.test.mjs",
    "test:exploration:browser": "node tests/exploration.browser.mjs",
    "test:all": "npm run test && npm run test:street && node tests/run-browser-all.mjs",
    "test:retry": "node tests/run-browser-all.mjs --retry-failed",
    "test:vehicle": "node tests/vehicle.browser.mjs",
    "test:signals": "node tests/turn-signals.browser.mjs",
    "test:street": "node --test --test-isolation=none tests/pedestrian-street.test.mjs",
    "test:street:browser": "node tests/pedestrian-street.browser.mjs",
    "test:passengers": "node tests/passengers.browser.mjs",
    "test:wheelchair": "node tests/wheelchair.browser.mjs",
    "test:routes": "node tests/routes.browser.mjs",
    "test:expansion": "node tests/expansion.browser.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.175.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
